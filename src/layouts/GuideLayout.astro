---
/**
 * GuideLayout — the shared shell for the long-form guides.
 *
 * Modelled on TestPageLayout: identical breadcrumb / eyebrow / h1 / lede header
 * band, the same `bleed` handling so the header rule runs edge to edge, and the
 * same "more of this kind of thing" block at the foot.
 *
 * The one addition is the prose <style> at the bottom. Guides are written as
 * plain semantic markup — <h2>, <p>, <ul>, <table> — and get their typography
 * from here, so no guide page has to repeat a wall of utility classes and no
 * two guides can drift into different heading sizes.
 */
import SiteLayout from "./SiteLayout.astro";
import Eyebrow from "../components/site/Eyebrow.astro";
import Card from "../components/site/Card.astro";

export interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  /** ISO date, e.g. "2026-08-27". Rendered as a visible "Last reviewed" line. */
  updated: string;
  /** Slug of this guide, so it is excluded from the related list. */
  slug: string;
  noindex?: boolean;
}

export interface GuideDef {
  readonly slug: string;
  readonly href: string;
  readonly title: string;
  readonly blurb: string;
}

/**
 * The guide registry.
 *
 * This lives in the layout rather than in lib/ or duplicated per page because
 * both consumers are presentational and must never disagree: /guides renders it
 * as the index, and the related-links block at the foot of every guide renders
 * the same array minus the current page. One list, so the index and the
 * cross-links cannot drift apart.
 */
export const GUIDES: readonly GuideDef[] = [
  {
    slug: "dead-vs-stuck-pixel",
    href: "/guides/dead-vs-stuck-pixel",
    title: "Dead pixel vs stuck pixel",
    blurb:
      "One is unpowered and permanent, the other is jammed and sometimes fixable. How to tell which you have in under a minute.",
  },
  {
    slug: "how-to-test-a-new-monitor",
    href: "/guides/how-to-test-a-new-monitor",
    title: "How to test a new monitor",
    blurb:
      "The first thirty minutes, in the order that matters, so you know whether to return it while the window is still open.",
  },
  {
    slug: "dead-pixel-warranty-policies",
    href: "/guides/dead-pixel-warranty-policies",
    title: "Dead pixel warranty policies",
    blurb:
      "How to find the policy that actually governs your panel, and how to make a claim that is hard to wave away.",
  },
  {
    slug: "how-to-test-a-phone-screen",
    href: "/guides/how-to-test-a-phone-screen",
    title: "How to test a phone screen",
    blurb:
      "OLED burn-in, PWM flicker, tint shift and the iOS full-screen limitation, stated honestly.",
  },
  {
    slug: "iso-pixel-fault-classes",
    href: "/guides/iso-pixel-fault-classes",
    title: "ISO pixel fault classes explained",
    blurb:
      "What Class I to IV mean, why the limits are per million pixels, and why a computed class is evidence rather than a guarantee.",
  },
] as const;

const { title, description, heading, lede, updated, slug, noindex = false } =
  Astro.props;

const related = GUIDES.filter((g) => g.slug !== slug);

const reviewed = new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<SiteLayout {title} {description} {noindex} ogType="article" bleed>
  <slot name="head" slot="head" />

  <article>
    <header class="border-b border-hairline bg-canvas">
      <div class="mx-auto max-w-page px-4 pt-10 pb-12 md:px-6 md:pt-14">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-caption text-mute">
            <li><a href="/" class="hover:text-ink">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/guides" class="hover:text-ink">Guides</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-body">{heading}</li>
          </ol>
        </nav>

        <Eyebrow>Guide</Eyebrow>

        <h1 class="mt-3 max-w-3xl text-display-lg text-ink">{heading}</h1>
        <p class="mt-4 max-w-prose text-body-lg text-body">{lede}</p>
        <p class="mt-6 text-caption text-mute">
          Last reviewed <time datetime={updated}>{reviewed}</time>
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-page px-4 py-12 md:px-6">
      <div class="guide-prose max-w-prose">
        <slot />
      </div>

      <section class="mt-16 border-t border-hairline pt-12">
        <Eyebrow as="h2">More guides</Eyebrow>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            related.map((guide) => (
              <li>
                <Card href={guide.href} elevation="e1" padding="md" class="h-full">
                  <p class="text-body-sm font-medium text-ink">{guide.title}</p>
                  <p class="mt-1 text-caption text-body">{guide.blurb}</p>
                </Card>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</SiteLayout>

<style>
  /* Slotted guide markup carries no Astro scope hash, so every rule below has
     to reach it through :global(). The font-size / line-height / letter-spacing
     values are read straight from the @theme scale in global.css — h2 mirrors
     display-md, h3 mirrors display-sm, body mirrors body-md — so the guides
     stay on the same type ramp as the rest of the site without hardcoding a
     single number here. Weight never exceeds 500 (`font-medium`), per DESIGN.md. */

  .guide-prose {
    color: var(--color-body);
    font-size: var(--text-body-md);
    line-height: var(--text-body-md--line-height);
  }

  .guide-prose > :global(* + *) {
    margin-top: 1rem;
  }

  .guide-prose :global(h2) {
    margin-top: 2.5rem;
    color: var(--color-ink);
    font-size: var(--text-display-md);
    line-height: var(--text-display-md--line-height);
    letter-spacing: var(--text-display-md--letter-spacing);
    font-weight: 500;
  }

  .guide-prose :global(h3) {
    margin-top: 2rem;
    color: var(--color-ink);
    font-size: var(--text-display-sm);
    line-height: var(--text-display-sm--line-height);
    letter-spacing: var(--text-display-sm--letter-spacing);
    font-weight: 500;
  }

  .guide-prose :global(h2 + h3),
  .guide-prose :global(h2 + p),
  .guide-prose :global(h3 + p) {
    margin-top: 0.75rem;
  }

  .guide-prose :global(strong) {
    color: var(--color-ink);
    font-weight: 500;
  }

  .guide-prose :global(em) {
    font-style: italic;
  }

  .guide-prose :global(a) {
    color: var(--color-link);
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-bg-soft);
    text-underline-offset: 2px;
    transition-property: text-decoration-color;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }

  .guide-prose :global(a:hover) {
    text-decoration-color: var(--color-link);
  }

  .guide-prose :global(ul),
  .guide-prose :global(ol) {
    padding-left: 1.5rem;
  }

  .guide-prose :global(ul) {
    list-style-type: disc;
  }

  .guide-prose :global(ol) {
    list-style-type: decimal;
  }

  .guide-prose :global(li::marker) {
    color: var(--color-mute);
  }

  .guide-prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .guide-prose :global(li > ul),
  .guide-prose :global(li > ol) {
    margin-top: 0.5rem;
  }

  /* Tables can outrun 720px on a phone, so the wrapper scrolls rather than
     forcing the whole column wider. */
  .guide-prose :global(.guide-table) {
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
  }

  .guide-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    letter-spacing: var(--text-body-sm--letter-spacing);
  }

  .guide-prose :global(caption) {
    padding: 0.75rem 1rem;
    color: var(--color-mute);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    text-align: left;
  }

  .guide-prose :global(th),
  .guide-prose :global(td) {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-hairline);
    text-align: left;
    vertical-align: top;
  }

  .guide-prose :global(thead th) {
    background-color: var(--color-canvas-soft-2);
    color: var(--color-ink);
    font-weight: 500;
    white-space: nowrap;
  }

  .guide-prose :global(tbody th) {
    color: var(--color-ink);
    font-weight: 500;
  }

  .guide-prose :global(tbody tr:last-child th),
  .guide-prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .guide-prose :global(code) {
    padding: 0.125em 0.375em;
    border-radius: var(--radius-xs);
    background-color: var(--color-canvas-soft-2);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-code);
  }

  .guide-prose :global(a code) {
    color: inherit;
  }

  .guide-prose :global(hr) {
    margin-top: 2.5rem;
    border: 0;
    border-top: 1px solid var(--color-hairline);
  }

  .guide-prose :global(blockquote) {
    padding-left: 1rem;
    border-left: 2px solid var(--color-hairline-strong);
    color: var(--color-body);
  }
</style>
