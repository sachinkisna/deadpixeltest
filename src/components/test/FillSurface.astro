---
/**
 * FillSurface — the complete colour-fill test experience.
 *
 * Shared by the single-colour pages and the guided sequence, so the two are
 * literally the same product with a different starting fill and a different
 * list. Driven by `lib/fillRunner.ts`, which finds every control below via its
 * `data-*` hook.
 *
 * The full fill list is rendered into a `<script type="application/json">` tag
 * rather than being inlined into a module script, so a page can hand over an
 * arbitrary subset without a bundler round-trip.
 */
import TestSurface from "./TestSurface.astro";
import TestHud from "./TestHud.astro";
import { DEFECT_SHORT, DEFECT_TYPES } from "../../lib/defects";
import type { Fill } from "../../lib/palette";

export interface Props {
  id?: string;
  /** Fills this surface can cycle through, in order. */
  fills: readonly Fill[];
  /** Index within `fills` to open on. */
  startIndex?: number;
  /** Hides prev/next when a page only ever shows one fill. */
  showNav?: boolean;
}

const { id = "surface", fills, startIndex = 0, showNav = true } = Astro.props;

const first = fills[startIndex] ?? fills[0];
if (!first) throw new Error("FillSurface requires at least one fill.");
---

<script
  is:inline
  type="application/json"
  data-fill-config
  set:html={JSON.stringify({ fills, startIndex })}
/>

<TestSurface id={id}>
  <!-- The measured surface. role="img" lives here, not on the container. -->
  <div
    class="dpt-fill"
    data-fill-layer
    data-fill-slug={first.slug}
    role="img"
    aria-label={`Full screen ${first.name} fill`}
    style={`background-color:${first.hex}`}
  >
  </div>

  <TestHud slot="hud">
    <p data-hud-note class="dpt-hud-note" hidden></p>

    {
      showNav && (
        <div class="dpt-hud-group">
          <button
            type="button"
            data-nav-prev
            class="dpt-hud-btn dpt-hud-btn--icon"
            aria-label="Previous fill"
          >
            <span aria-hidden="true">&#9664;</span>
          </button>
          <span class="dpt-hud-label">
            <b data-fill-name>{first.name}</b>
            <span class="dpt-hud-sub" data-fill-position>
              {startIndex + 1} / {fills.length}
            </span>
          </span>
          <button
            type="button"
            data-nav-next
            class="dpt-hud-btn dpt-hud-btn--icon"
            aria-label="Next fill"
          >
            <span aria-hidden="true">&#9654;</span>
          </button>
        </div>
      )
    }

    {
      !showNav && (
        <span class="dpt-hud-label">
          <b data-fill-name>{first.name}</b>
        </span>
      )
    }

    <div class="dpt-hud-group">
      <button
        type="button"
        data-tag-arm
        aria-pressed="false"
        class="dpt-hud-btn dpt-hud-btn--danger"
      >
        Mark defect
        <span class="dpt-hud-sub">(<span data-tag-count>0</span>)</span>
      </button>
      <button type="button" data-hud-help aria-pressed="false" class="dpt-hud-btn">
        Help
        <kbd class="dpt-hud-kbd">H</kbd>
      </button>
      <button type="button" data-surface-exit class="dpt-hud-btn">
        Exit
        <kbd class="dpt-hud-kbd">Esc</kbd>
      </button>
    </div>

    <!-- Revealed only while marking is armed. -->
    <div data-tag-panel hidden class="dpt-hud-row">
      <span class="dpt-hud-sub">Type</span>
      {
        DEFECT_TYPES.map((type) => (
          <button
            type="button"
            data-defect-type={type}
            aria-pressed="false"
            class="dpt-hud-btn"
          >
            {DEFECT_SHORT[type]}
          </button>
        ))
      }
      <button type="button" data-tag-centre class="dpt-hud-btn">
        Log at centre
      </button>
    </div>

    <!-- Revealed by the Help toggle. Carries the per-fill guidance, which is
         the thing users actually need and which a bare colour screen cannot
         convey on its own. -->
    <div data-help-panel hidden class="dpt-hud-help">
      <p data-fill-reveals></p>
      <p class="dpt-hud-sub">
        <kbd class="dpt-hud-kbd">&larr;</kbd>
        <kbd class="dpt-hud-kbd">&rarr;</kbd> change fill &middot;
        <kbd class="dpt-hud-kbd">H</kbd> help &middot;
        <kbd class="dpt-hud-kbd">Esc</kbd> exit &middot; tap a marker to remove
        it
      </p>
    </div>

    <!-- Announcements for screen readers; never shown visually, so it cannot
         obscure a pixel. -->
    <p data-tag-status role="status" aria-live="polite" class="dpt-sr"></p>
  </TestHud>
</TestSurface>

<style>
  /* Full-width HUD rows. Scoped here rather than global.css because only this
     composite uses them. */
  .dpt-hud-row {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding-top: 0.375rem;
    border-top: 1px solid #262626;
  }

  .dpt-hud-row[hidden] {
    display: none;
  }

  .dpt-hud-help {
    width: 100%;
    max-width: 34rem;
    padding-top: 0.375rem;
    border-top: 1px solid #262626;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }

  .dpt-hud-help[hidden] {
    display: none;
  }

  .dpt-hud-help p + p {
    margin-top: 0.375rem;
  }

  .dpt-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
