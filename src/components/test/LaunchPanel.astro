---
/**
 * LaunchPanel — the "start the test" block shared by every test page.
 *
 * Carries the launch control plus the prerequisites that decide whether a
 * result is meaningful. The dark-room note is not decoration: judging backlight
 * bleed in a lit room is the single most common way people record a wrong
 * result, so the warning sits directly above the button rather than buried in
 * prose further down.
 *
 * The launch button carries `data-surface-launch`, which is the hook
 * `lib/fillRunner.ts` and the per-test scripts bind to.
 */
import Button from "../site/Button.astro";
import Badge from "../site/Badge.astro";

export interface Props {
  /** Button text. */
  label?: string;
  needsDarkRoom?: boolean;
  /** Extra prerequisites specific to this test. */
  prerequisites?: readonly string[];
  /** Disables the button in markup — used behind the epilepsy gate. */
  gated?: boolean;
  class?: string | undefined;
}

const {
  label = "Launch full screen",
  needsDarkRoom = false,
  prerequisites = [],
  gated = false,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "rounded-lg border border-hairline bg-canvas p-5 shadow-e2 md:p-6",
    className,
  ]}
>
  {
    (needsDarkRoom || prerequisites.length > 0) && (
      <>
        <p class="text-body-sm font-medium text-ink">Before you start</p>
        <ul class="mt-3 flex flex-col gap-2">
          {needsDarkRoom && (
            <li class="flex items-start gap-2 text-body-sm text-body">
              <Badge tone="warning">Dark room</Badge>
              <span>
                Turn the lights off and give your eyes a minute to adjust. This
                test is unreadable in a lit room.
              </span>
            </li>
          )}
          {prerequisites.map((item) => (
            <li class="text-body-sm text-body">&middot; {item}</li>
          ))}
        </ul>
      </>
    )
  }

  <div
    class:list={[
      "flex flex-col gap-3 sm:flex-row sm:items-center",
      (needsDarkRoom || prerequisites.length > 0) && "mt-5",
    ]}
  >
    <Button
      type="button"
      size="lg"
      shape="pill"
      disabled={gated}
      data-surface-launch
      data-gated={gated ? true : undefined}
    >
      {label}
    </Button>
    <p class="text-body-sm text-mute">
      Press <kbd
        class="rounded-xs border border-hairline bg-canvas-soft-2 px-1 font-mono text-caption text-body"
        >Esc</kbd
      > to come back.
    </p>
  </div>

  <slot />
</div>
