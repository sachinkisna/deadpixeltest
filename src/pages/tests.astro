---
/**
 * /tests — the full index.
 *
 * Derived entirely from the registry, so it can never fall out of step with
 * what actually exists.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Card from "../components/site/Card.astro";
import Badge from "../components/site/Badge.astro";
import Eyebrow from "../components/site/Eyebrow.astro";
import Button from "../components/site/Button.astro";
import { FILLS } from "../lib/palette";
import { groupedTests, TESTS } from "../lib/tests";

const groups = groupedTests();
---

<SiteLayout
  title={`All ${TESTS.length} Screen Tests — Dead Pixel, Backlight, Refresh Rate & More`}
  description={`Every screen test on the site: dead and stuck pixels, backlight bleed, uniformity, gradient banding, pixel inversion, refresh rate, response time, viewing angle and resolution. Free, offline-capable, no account.`}
  bleed
>
  <header class="border-b border-hairline bg-canvas">
    <div class="mx-auto max-w-page px-4 pt-12 pb-14 md:px-6 md:pt-16">
      <Eyebrow>Index</Eyebrow>
      <h1 class="mt-3 max-w-3xl text-display-lg text-ink">
        Every test, and what each one actually tells you
      </h1>
      <p class="mt-4 max-w-prose text-body-lg text-body">
        {TESTS.length} tests covering pixel faults, panel quality, motion and
        signal. All of them run in the browser, none of them need an account, and
        the whole suite works with the network off after your first visit.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="/test/sequence" size="lg" shape="pill">
          Start with the guided test
        </Button>
        <Button href="/report" size="lg" shape="pill" variant="secondary">
          View my report
        </Button>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-page px-4 py-14 md:px-6 md:py-16">
    <div class="flex flex-col gap-14">
      {
        groups.map((group) => (
          <section aria-labelledby={`cat-${group.category}`}>
            <h2 id={`cat-${group.category}`} class="text-display-md text-ink">
              {group.label}
            </h2>
            <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.tests.map((test) => (
                <li>
                  <Card
                    href={test.href}
                    elevation="e2"
                    padding="lg"
                    class="flex h-full flex-col"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <h3 class="text-body-lg font-medium text-ink">
                        {test.name}
                      </h3>
                      {test.needsDarkRoom && (
                        <Badge tone="warning">Dark room</Badge>
                      )}
                    </div>
                    <p class="mt-2 text-body-sm text-body">{test.blurb}</p>
                    {test.limitation && (
                      <p class="mt-3 text-caption text-warning-deep">
                        Perceptual &mdash; limits stated on the page
                      </p>
                    )}
                  </Card>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <section aria-labelledby="cat-fills">
        <h2 id="cat-fills" class="text-display-md text-ink">
          Single colour fills
        </h2>
        <p class="mt-2 max-w-prose text-body-md text-body">
          Direct links, if you already know which colour you need. Every fill is
          an exact sRGB value painted by the browser.
        </p>
        <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {
            FILLS.map((fill) => (
              <li>
                <a
                  href={`/test/${fill.slug}`}
                  class="flex items-center gap-3 rounded-md border border-hairline bg-canvas p-3 shadow-e1 transition-shadow duration-150 ease-out hover:shadow-e3"
                >
                  <span
                    class="size-8 shrink-0 rounded-sm shadow-e1"
                    style={`background-color:${fill.hex}`}
                    aria-hidden="true"
                  />
                  <span>
                    <span class="block text-body-sm font-medium text-ink">
                      {fill.name}
                    </span>
                    <span class="block font-mono text-caption text-mute uppercase">
                      {fill.hex}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</SiteLayout>
