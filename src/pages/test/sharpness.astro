---
/**
 * Sharpness and text clarity test.
 *
 * The text ladder is real live text, not an image of text, so it exercises the
 * browser's own font rasteriser and the panel's subpixel layout together — which
 * is what the user is actually complaining about when they say text looks
 * fuzzy. An image would be scaled and would tell them nothing.
 */
import TestPageLayout from "../../layouts/TestPageLayout.astro";
import TestSurface from "../../components/test/TestSurface.astro";
import TestHud from "../../components/test/TestHud.astro";
import LaunchPanel from "../../components/test/LaunchPanel.astro";
import Eyebrow from "../../components/site/Eyebrow.astro";
import Card from "../../components/site/Card.astro";
import { getTest } from "../../lib/tests";
import type { PatternDef } from "../../lib/patternRunner";

const test = getTest("sharpness");
if (!test) throw new Error("Missing registry entry: sharpness");

const LIMITATION =
  "A browser cannot tell you where the scaling happened. Panel-side interpolation, non-integer operating-system display scaling and browser zoom all produce the same soft, moiré-flecked result, and none of them is visible to JavaScript. Set browser zoom to exactly 100% before you start — that removes one of the three. The other two you have to rule out from the display settings themselves.";

/** 9px to 24px. Small sizes first: that is where scaling shows. */
const LADDER_SIZES = [9, 11, 13, 16, 20, 24] as const;
const LADDER_TEXT = "Handgloves 0O1lI — quartz sphinx judge, vex 5%";

const PATTERNS: readonly PatternDef[] = [
  {
    id: "grid-1",
    name: "1px grid",
    reveals:
      "A crisp, perfectly even lattice means you are at native resolution. Blur, wavy moiré bands, or lines that alternate thick and thin across the screen mean the image is being resampled.",
  },
  {
    id: "v-greys",
    name: "1px lines, three greys",
    reveals:
      "Three vertical line pairs at different contrasts. Each band should stay uniform from top to bottom. A halo or dark edge where two bands meet is edge enhancement, not softness.",
  },
  {
    id: "text",
    name: "Text ladder",
    reveals:
      "Live text from 9px to 24px, sans and mono, both polarities. The 9px row should be legible but tight. Coloured fringes are normal subpixel antialiasing; even blur on every size is scaling.",
  },
  {
    id: "zone",
    name: "Concentric rings",
    reveals:
      "Rings of increasing frequency toward the centre. Any scaling or sharpening turns the fine rings into large swirling moiré rosettes, which is far easier to spot than the blur that causes it.",
  },
  {
    id: "cross",
    name: "1px crosses",
    reveals:
      "A single-pixel white cross on black and a black cross on white. Both should be one hairline wide with no grey ghost beside them. A bright fringe on one side is overshoot from a sharpness filter.",
  },
];
---

<TestPageLayout
  title="Sharpness & Text Clarity Test — Check Native Resolution and Scaling"
  description="Free full-screen 1px grids, line pairs, a text ladder and a ring target to check whether your display is running at native resolution. Explains scaling, edge enhancement and RGB versus BGR subpixel order."
  heading="Sharpness and text clarity"
  lede={test.description}
  category="panel"
  slug="sharpness"
  limitation={LIMITATION}
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14">
    <div class="max-w-prose">
      <LaunchPanel
        label="Launch sharpness patterns"
        prerequisites={[
          "Set browser zoom to exactly 100%. At 110% or 90% every pattern here will look soft no matter how good the display is.",
          "Check the reported resolution on the resolution test first, and have your panel's spec sheet to hand.",
          "Look at the patterns straight on. Off-axis, a fine grid moirés on every panel ever made.",
        ]}
      />

      <section class="mt-12">
        <Eyebrow as="h2">Reading it</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Crisp and even, or soft and swimming
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            <strong class="font-medium text-ink">Good.</strong> The 1px grid is a
            uniform lattice. Every line is the same weight as every other line,
            corner to corner, and it looks static. The crosses are single
            hairlines. The 9px text row is small but cleanly formed.
          </p>
          <p>
            <strong class="font-medium text-ink">Faulty.</strong> Lines alternate
            between thick and thin in a repeating pattern across the width of the
            screen, or the grid dissolves into slow wavy bands, or the whole
            field looks grey and blurred rather than black-and-white. All three
            are signatures of resampling: the source grid and the panel's pixel
            grid do not line up, so the display is interpolating between them.
          </p>
          <p>
            <strong class="font-medium text-ink">Ringing</strong> is different and
            worth learning to recognise separately. If each line has a brighter
            line just beside it, or the crosses have a faint halo, the image is
            not soft &mdash; it is over-sharpened. Something in the chain is
            adding artificial edge contrast.
          </p>
        </div>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Causes</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Three real causes, in order of likelihood
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <ol class="flex flex-col gap-3">
            <li>
              <strong class="font-medium text-ink"
                >1. Not running at native resolution.</strong
              > The operating system is sending, say, 1920&times;1080 to a 2560&times;1440
              panel, and the panel's scaler is stretching every pixel across 1.33
              of its own. Nothing can look sharp under that. Check what the browser
              reports on the
              <a
                href="/test/resolution"
                class="text-link underline decoration-link-bg-soft underline-offset-2 hover:decoration-link"
                >resolution and scaling test</a
              > and compare it with the panel's spec sheet. If they differ, that is
              your answer and it is a two-click fix in display settings.
            </li>
            <li>
              <strong class="font-medium text-ink"
                >2. A sharpness or edge-enhancement setting.</strong
              > Almost universal on televisions used as monitors, and common on monitors
              in a Game or Movie preset. Anything above the neutral position adds
              ringing halos; on most TVs neutral is 0 but on some it is the middle
              of the scale, so find the value where the halos on the cross pattern
              disappear. Look also for names like Super Resolution, Clarity, DNR or
              Detail Enhancement, and turn all of them off.
            </li>
            <li>
              <strong class="font-medium text-ink"
                >3. Non-integer display scaling.</strong
              > 125% or 150% on Windows, or any scale factor that is not exactly 2&times;
              on macOS, means the system renders at one size and resamples to another.
              Some applications handle it cleanly and some render at 100% and get stretched.
              Try 100% or 200% and compare this grid at each.
            </li>
          </ol>
        </div>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Subpixels</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Coloured fringes on text are normal
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            Lean in close to the text ladder and you will see faint orange and
            blue edges on the letter stems. That is subpixel antialiasing working
            as designed. Each pixel is three separate stripes &mdash; red, green,
            blue &mdash; and the renderer addresses them individually to place an
            edge at one-third-pixel precision. The fringes are the price, and they
            are invisible at normal viewing distance.
          </p>
          <p>
            It only becomes a fault if the fringes are the wrong way round. The
            renderer assumes stripes are ordered red-green-blue from left to
            right; a minority of panels, and most panels rotated into portrait,
            are effectively BGR. Then every correction is applied backwards and
            text looks oddly fringed and unstable rather than sharp. Both Windows
            (through ClearType tuning) and most Linux desktops let you set the
            subpixel order explicitly; macOS removed subpixel antialiasing
            entirely, so on a Mac this simply will not apply.
          </p>
        </div>
      </section>
    </div>

    <aside class="lg:pt-1">
      <Card elevation="e2" padding="lg">
        <Eyebrow as="h2">Patterns</Eyebrow>
        <ol class="mt-4 flex flex-col gap-3 text-body-sm text-body">
          {
            PATTERNS.map((pattern, i) => (
              <li>
                <p class="font-medium text-ink">
                  <span class="font-mono text-caption text-mute">
                    {String(i + 1).padStart(2, "0")}
                  </span>{" "}
                  {pattern.name}
                </p>
                <p class="mt-0.5">{pattern.reveals}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-caption text-mute">
          Arrow keys change pattern. Every pattern is authored in CSS pixels, so
          hold browser zoom at 100% for the whole run.
        </p>
      </Card>
    </aside>
  </div>

  <!-- The pattern list crosses from frontmatter to the client here rather than
       being retyped in the module script below. -->
  <script
    slot="surface"
    is:inline
    type="application/json"
    data-pattern-config
    set:html={JSON.stringify(PATTERNS)}
  />

  <TestSurface slot="surface" id="surface">
    <div
      class="shp-layer"
      role="img"
      aria-label="Full screen fine grid and text pattern for judging sharpness"
    >
      <!-- Gradient-drawn patterns need no markup; the layer itself carries
           them. These three need real elements. -->
      <div class="shp-band-set" data-block="v-greys">
        <div class="shp-band" data-band="high"></div>
        <div class="shp-band" data-band="mid"></div>
        <div class="shp-band" data-band="low"></div>
      </div>

      <div class="shp-ladder" data-block="text">
        <div class="shp-ladder-col shp-ladder-col--light">
          {
            LADDER_SIZES.map((px) => (
              <p class="shp-line" style={`font-size:${px}px`}>
                <span class="shp-px">{px}px</span> {LADDER_TEXT}
              </p>
            ))
          }
          {
            LADDER_SIZES.map((px) => (
              <p class="shp-line shp-line--mono" style={`font-size:${px}px`}>
                <span class="shp-px">{px}px</span> {LADDER_TEXT}
              </p>
            ))
          }
        </div>
        <div class="shp-ladder-col shp-ladder-col--dark">
          {
            LADDER_SIZES.map((px) => (
              <p class="shp-line" style={`font-size:${px}px`}>
                <span class="shp-px">{px}px</span> {LADDER_TEXT}
              </p>
            ))
          }
          {
            LADDER_SIZES.map((px) => (
              <p class="shp-line shp-line--mono" style={`font-size:${px}px`}>
                <span class="shp-px">{px}px</span> {LADDER_TEXT}
              </p>
            ))
          }
        </div>
      </div>

      <div class="shp-crosses" data-block="cross">
        <div class="shp-cross-cell shp-cross-cell--black">
          <div class="shp-cross-h"></div>
          <div class="shp-cross-v"></div>
        </div>
        <div class="shp-cross-cell shp-cross-cell--white">
          <div class="shp-cross-h"></div>
          <div class="shp-cross-v"></div>
        </div>
      </div>
    </div>

    <TestHud slot="hud" label="Sharpness pattern controls">
      <p data-hud-note class="dpt-hud-note" hidden></p>

      <div class="dpt-hud-group">
        <button
          type="button"
          data-nav-prev
          class="dpt-hud-btn dpt-hud-btn--icon"
          aria-label="Previous pattern"
        >
          <span aria-hidden="true">&#9664;</span>
        </button>
        <span class="dpt-hud-label">
          <b data-pattern-name>1px grid</b>
          <span class="dpt-hud-sub" data-pattern-position>1 / 5</span>
        </span>
        <button
          type="button"
          data-nav-next
          class="dpt-hud-btn dpt-hud-btn--icon"
          aria-label="Next pattern"
        >
          <span aria-hidden="true">&#9654;</span>
        </button>
      </div>

      <div class="dpt-hud-group">
        <button type="button" data-hud-help aria-pressed="false" class="dpt-hud-btn">
          Help
          <kbd class="dpt-hud-kbd">H</kbd>
        </button>
        <button type="button" data-surface-exit class="dpt-hud-btn">
          Exit
          <kbd class="dpt-hud-kbd">Esc</kbd>
        </button>
      </div>

      <div data-help-panel hidden class="shp-help">
        <p data-pattern-reveals></p>
        <p class="dpt-hud-sub">
          Browser zoom must be 100%. Coloured fringes on text are subpixel
          antialiasing, not a fault.
        </p>
      </div>

      <p data-pattern-status role="status" aria-live="polite" class="shp-sr"></p>
    </TestHud>
  </TestSurface>
</TestPageLayout>

<style>
  /* ── CSS px versus device px ──────────────────────────────────────────────
     Everything here is authored in CSS pixels, which is the only unit a
     stylesheet has. On a 2x or 3x display one CSS px covers several device
     pixels, so a "1px grid" is physically 2 or 3 panel pixels wide. That still
     detects scaling — a resampled 2px line is just as uneven as a resampled 1px
     one — but it is not a true native-resolution probe on HiDPI hardware. The
     page tells the user to hold browser zoom at 100%, which is the one variable
     they control. All gradients use hard stops; a soft stop would blur the line
     into the grey we are looking for. */

  .shp-layer {
    position: absolute;
    inset: 0;
    background-color: #000;
    image-rendering: pixelated;
  }

  /* Pattern 1 — 1px grid, both axes on the one element. */
  :global(.dpt-surface[data-pattern="grid-1"]) .shp-layer {
    background-color: #000;
    background-image:
      repeating-linear-gradient(to right, #ffffff 0px 1px, #000000 1px 4px),
      repeating-linear-gradient(to bottom, #ffffff 0px 1px, #000000 1px 4px);
  }

  /* Pattern 4 — concentric rings. Not a true zone plate (frequency does not
     sweep, since repeating-radial-gradient has a fixed period), but a fixed
     fine period against the pixel grid produces the same diagnostic moiré. */
  :global(.dpt-surface[data-pattern="zone"]) .shp-layer {
    background-image: repeating-radial-gradient(
      circle at center,
      #ffffff 0px 1px,
      #000000 1px 3px
    );
  }

  /* Only the block matching the active pattern is displayed. */
  .shp-band-set,
  .shp-ladder,
  .shp-crosses {
    position: absolute;
    inset: 0;
    display: none;
  }

  :global(.dpt-surface[data-pattern="v-greys"]) [data-block="v-greys"],
  :global(.dpt-surface[data-pattern="text"]) [data-block="text"],
  :global(.dpt-surface[data-pattern="cross"]) [data-block="cross"] {
    display: flex;
  }

  /* Pattern 2 — three 1px vertical line pairs at descending contrast. Reading
     the same structure at three contrasts separates a scaling problem (all
     three degrade) from an overdrive or gamma problem (only the low-contrast
     band does). */
  .shp-band-set {
    flex-direction: column;
  }

  .shp-band {
    flex: 1;
    min-height: 0;
  }

  .shp-band[data-band="high"] {
    background-image: repeating-linear-gradient(
      to right,
      #ffffff 0px 1px,
      #000000 1px 2px
    );
  }

  .shp-band[data-band="mid"] {
    background-image: repeating-linear-gradient(
      to right,
      #c0c0c0 0px 1px,
      #404040 1px 2px
    );
  }

  .shp-band[data-band="low"] {
    background-image: repeating-linear-gradient(
      to right,
      #909090 0px 1px,
      #707070 1px 2px
    );
  }

  /* Pattern 3 — the text ladder. Two columns, opposite polarity. */
  .shp-ladder {
    align-items: stretch;
  }

  .shp-ladder-col {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 1rem 1rem 5rem;
    font-family: var(--font-sans);
  }

  .shp-ladder-col--light {
    background-color: #ffffff;
    color: #000000;
  }

  .shp-ladder-col--dark {
    background-color: #000000;
    color: #ffffff;
  }

  .shp-line {
    /* Line height in em so each row scales with its own font size and the
       ladder stays evenly spaced from 9px to 24px. */
    line-height: 1.45em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shp-line--mono {
    font-family: var(--font-mono);
  }

  .shp-px {
    font-family: var(--font-mono);
  }

  /* Pattern 5 — a 1px cross on each polarity, side by side so both can be
     judged without a pattern change in between. */
  .shp-crosses {
    align-items: stretch;
  }

  .shp-cross-cell {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .shp-cross-cell--black {
    background-color: #000000;
  }

  .shp-cross-cell--white {
    background-color: #ffffff;
  }

  /* Positioned with a 50% offset and no transform: a transform on a hairline is
     the one thing guaranteed to land it on a half-pixel and blur it, which
     would look exactly like the fault we are testing for. */
  .shp-cross-h,
  .shp-cross-v {
    position: absolute;
  }

  .shp-cross-h {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .shp-cross-v {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .shp-cross-cell--black .shp-cross-h,
  .shp-cross-cell--black .shp-cross-v {
    background-color: #ffffff;
  }

  .shp-cross-cell--white .shp-cross-h,
  .shp-cross-cell--white .shp-cross-v {
    background-color: #000000;
  }

  .shp-help {
    width: 100%;
    max-width: 34rem;
    padding-top: 0.375rem;
    border-top: 1px solid #262626;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }

  .shp-help[hidden] {
    display: none;
  }

  .shp-help p + p {
    margin-top: 0.375rem;
  }

  .shp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { mountPatternRunner, type PatternDef } from "../../lib/patternRunner";

  const configEl = document.querySelector<HTMLScriptElement>(
    "[data-pattern-config]",
  );
  if (configEl?.textContent) {
    mountPatternRunner({
      patterns: JSON.parse(configEl.textContent) as PatternDef[],
    });
  }
</script>
