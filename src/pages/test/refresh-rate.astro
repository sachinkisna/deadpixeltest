---
/**
 * Refresh rate test.
 *
 * The one motion measurement on this site that is genuinely reliable, because
 * requestAnimationFrame fires once per presented frame. See lib/refreshRunner.ts
 * for the reasoning, and for why the sweeping bar is driven from JavaScript
 * rather than by a CSS animation.
 */
import TestPageLayout from "../../layouts/TestPageLayout.astro";
import TestSurface from "../../components/test/TestSurface.astro";
import TestHud from "../../components/test/TestHud.astro";
import LaunchPanel from "../../components/test/LaunchPanel.astro";
import Eyebrow from "../../components/site/Eyebrow.astro";
import Card from "../../components/site/Card.astro";
import { getTest } from "../../lib/tests";

const test = getTest("refresh-rate");
if (!test) throw new Error("Missing registry entry: refresh-rate");

const linkClass =
  "text-link underline decoration-link-bg-soft underline-offset-2 hover:decoration-link";
---

<TestPageLayout
  title="Refresh Rate Test — Measure the Hz Your Browser Is Actually Getting"
  description="Measures frame timing over five seconds and reports the sustained refresh rate, so you can confirm a 144 Hz monitor is not quietly running at 60 Hz because of a cable, a driver default or a monitor setting."
  heading="Refresh rate test"
  lede={test.description}
  category="motion"
  slug="refresh-rate"
  limitation={test.limitation}
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14">
    <div class="max-w-prose">
      <LaunchPanel
        label="Measure refresh rate"
        prerequisites={[
          "Close other tabs and applications. A busy machine drops frames and reads low.",
          "Keep this window focused for the whole five seconds — browsers throttle background tabs hard.",
          "Unplug a laptop from battery power if you can. Power saving caps the refresh rate.",
        ]}
      />

      <section class="mt-12">
        <Eyebrow as="h2">Definitions</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Refresh rate is not frame rate
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            <strong class="font-medium text-ink">Refresh rate</strong> is how many
            times per second the display redraws itself, measured in hertz. It is a
            property of the monitor and the signal reaching it, and it is fixed
            unless something changes the timing.
          </p>
          <p>
            <strong class="font-medium text-ink">Frame rate</strong> is how many
            images per second the source produces. That varies constantly with
            load. A game at 200 fps on a 60 Hz panel still only shows you 60
            images a second; the other 140 are discarded.
          </p>
          <p>
            This test measures the first one, from the browser's side of the
            chain.
          </p>
        </div>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Reliability</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Why this measurement is trustworthy
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            Worth saying plainly, because the
            <a href="/test/response-time" class={linkClass}>response time test</a>
            on this site cannot make the same claim. There, the number a browser
            would need is generated inside the panel, after the frame has left the
            GPU, so any millisecond figure would be invented.
          </p>
          <p>
            Here the browser is measuring its own clock.
            <code class="font-mono text-code text-ink">requestAnimationFrame</code>
            fires once per presented frame, so the gaps between callbacks are the
            presentation rate. Take the median across several hundred frames and
            you have a real figure, not a fudge.
          </p>
          <p>
            The honest limit is scope, not accuracy. We see the rate at the end of
            the chain. A variable-refresh panel, a throttled tab or a compositor
            capped at 60 all read low on fast hardware. So a low reading tells you
            to go looking &mdash; it does not convict the panel.
          </p>
        </div>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Diagnosis</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Four reasons a 144 Hz monitor runs at 60
        </h2>
        <ol class="mt-4 flex flex-col gap-4 text-body-md text-body">
          <li>
            <strong class="font-medium text-ink">1. The OS is still set to 60.</strong>
            The commonest cause by a wide margin. Windows and macOS default a new
            display to 60 Hz and never mention it again. On Windows: Display
            settings &rarr; Advanced display &rarr; Choose a refresh rate. On
            macOS: Displays, then the Refresh Rate menu. Buying the monitor does
            not switch this on.
          </li>
          <li>
            <strong class="font-medium text-ink">2. The cable or port cannot carry it.</strong>
            Resolution and refresh rate share one bandwidth budget. HDMI 1.4
            cannot do 1440p at 144 Hz; DisplayPort 1.2 cannot do 4K above 60 Hz.
            If the high rate is missing from the OS list entirely, this is usually
            why. Check the port version on both ends, not just the cable.
          </li>
          <li>
            <strong class="font-medium text-ink">3. The monitor's own OSD.</strong>
            Many displays ship with the high rate disabled behind a setting called
            Overclock, DisplayPort version, or simply Refresh Rate. Some require a
            power cycle after changing it. The OS cannot offer a rate the monitor
            is not advertising.
          </li>
          <li>
            <strong class="font-medium text-ink">4. Laptop power saving.</strong>
            On battery, both Windows and macOS drop the panel to 60 Hz or lower to
            save power, and some laptops refuse high rates on the internal display
            regardless. Plug in, then measure again.
          </li>
        </ol>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Reading the result</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">What the numbers mean</h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            The measured figure is a median, so one scheduling hiccup will not
            skew it. It is snapped to a standard rate only when it lands within 2%
            of one; otherwise you get the raw number and a note that it matches
            nothing standard, which almost always means a disturbed sample.
          </p>
          <p>
            <strong class="font-medium text-ink">Worst frame</strong> is the check on
            everything else. If it is more than double the mean, the sample
            contains real stalls and the headline figure should not be trusted.
            Close things down and measure again. Also try the
            <a href="/test/resolution" class={linkClass}>resolution readout</a> &mdash;
            a display negotiated down to a lower resolution is often the same cable
            problem showing up twice.
          </p>
        </div>
      </section>
    </div>

    <aside class="lg:pt-1">
      <Card elevation="e2" padding="lg">
        <Eyebrow as="h2">In the test</Eyebrow>
        <ul class="mt-4 flex flex-col gap-3 text-body-sm text-body">
          <li>The live figure updates continuously as a rolling median.</li>
          <li>
            <strong class="font-medium text-ink">Measure</strong> takes a five
            second sample and writes a verdict.
          </li>
          <li>The white bar crosses the screen once per second.</li>
          <li>
            <kbd
              class="rounded-xs border border-hairline bg-canvas-soft-2 px-1 font-mono text-caption"
              >Space</kbd
            > measures,
            <kbd
              class="rounded-xs border border-hairline bg-canvas-soft-2 px-1 font-mono text-caption"
              >Esc</kbd
            > exits.
          </li>
          <li>Nothing is stored. Every reading is fresh.</li>
        </ul>
      </Card>
    </aside>
  </div>

  <TestSurface slot="surface" id="surface">
    <div
      class="dpt-fill refresh-field"
      role="img"
      aria-label="Black field with a white reference bar sweeping across it once per second"
    >
      <div class="refresh-bar" data-refresh-bar></div>
    </div>

    <div class="refresh-panel">
      <p class="refresh-live-row">
        <span class="refresh-live-label">Live</span>
        <b class="refresh-live-value" data-refresh-live data-numeric>&mdash;</b>
      </p>

      <dl class="refresh-stats">
        <div>
          <dt>Measured</dt>
          <dd data-refresh-hz data-numeric>&mdash;</dd>
        </div>
        <div>
          <dt>Mean frame</dt>
          <dd data-refresh-mean data-numeric>&mdash;</dd>
        </div>
        <div>
          <dt>Worst frame</dt>
          <dd data-refresh-worst data-numeric>&mdash;</dd>
        </div>
        <div>
          <dt>Frames</dt>
          <dd data-refresh-frames data-numeric>&mdash;</dd>
        </div>
      </dl>

      <div class="refresh-verdict" data-refresh-verdict hidden></div>
    </div>

    <TestHud slot="hud" label="Refresh rate controls">
      <p data-hud-note class="dpt-hud-note" hidden></p>

      <div class="dpt-hud-group">
        <button type="button" data-refresh-measure class="dpt-hud-btn">
          Measure 5s
        </button>
        <span class="dpt-hud-label">
          <b data-refresh-progress data-numeric>ready</b>
        </span>
        <button
          type="button"
          data-hud-help
          aria-pressed="false"
          class="dpt-hud-btn"
        >
          Help
          <kbd class="dpt-hud-kbd">H</kbd>
        </button>
        <button type="button" data-surface-exit class="dpt-hud-btn">
          Exit
          <kbd class="dpt-hud-kbd">Esc</kbd>
        </button>
      </div>

      <div data-help-panel hidden class="refresh-help">
        <p>
          The live figure is a rolling median over the last 40 frames, so it
          settles within a second. Measure takes a clean five second sample and
          interprets it. If the worst frame is more than double the mean, frames
          were dropped and the result is not reliable.
        </p>
        <p class="dpt-hud-sub">
          <kbd class="dpt-hud-kbd">Space</kbd> measure &middot;
          <kbd class="dpt-hud-kbd">H</kbd> help &middot;
          <kbd class="dpt-hud-kbd">Esc</kbd> exit
        </p>
      </div>

      <p data-refresh-status role="status" aria-live="polite" class="refresh-sr">
      </p>
    </TestHud>
  </TestSurface>
</TestPageLayout>

<style>
  .refresh-field {
    background-color: #000;
    overflow: hidden;
  }

  /* Full height, high contrast, deliberately narrow: a thin edge makes a
     duplicated or stuttering frame far easier to spot than a wide block. */
  .refresh-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 10px;
    background-color: #fff;
    will-change: translate;
  }

  .refresh-bar[hidden] {
    display: none;
  }

  .refresh-panel {
    position: absolute;
    top: max(1.5rem, env(safe-area-inset-top));
    left: 50%;
    translate: -50% 0;
    z-index: 10;
    width: min(38rem, calc(100vw - 2rem));
    padding: 1rem 1.25rem;
    border: 1px solid #404040;
    border-radius: 12px;
    /* Opaque, like the HUD. A translucent panel over a moving bar would be
       unreadable and would leave the user unsure what they were seeing. */
    background-color: #000;
    color: #fff;
    font-family: var(--font-sans);
    text-align: center;
  }

  .refresh-live-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.625rem;
    margin: 0;
  }

  .refresh-live-label {
    color: #a1a1a1;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .refresh-live-value {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .refresh-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    margin: 0.875rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid #262626;
  }

  @media (min-width: 600px) {
    .refresh-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .refresh-stats dt {
    color: #a1a1a1;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .refresh-stats dd {
    margin: 0.125rem 0 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .refresh-verdict {
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid #262626;
    font-size: 0.8125rem;
    line-height: 1.45;
    text-align: left;
  }

  .refresh-verdict[hidden] {
    display: none;
  }

  .refresh-verdict p {
    margin: 0;
  }

  .refresh-verdict p + p {
    margin-top: 0.5rem;
    color: #a1a1a1;
  }

  .refresh-help {
    width: 100%;
    max-width: 34rem;
    padding-top: 0.375rem;
    border-top: 1px solid #262626;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }

  .refresh-help[hidden] {
    display: none;
  }

  .refresh-help p + p {
    margin-top: 0.375rem;
  }

  .refresh-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { mountRefreshRunner } from "../../lib/refreshRunner";
  mountRefreshRunner();
</script>
