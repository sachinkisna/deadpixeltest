---
/**
 * Pixel inversion test.
 *
 * Every pattern here is drawn with CSS gradients rather than an image, because
 * an image would be resampled by the browser and the single-pixel structure —
 * the entire point of the test — would be destroyed before it reached the
 * panel. See the scoped <style> for the device-pixel caveat.
 */
import TestPageLayout from "../../layouts/TestPageLayout.astro";
import TestSurface from "../../components/test/TestSurface.astro";
import TestHud from "../../components/test/TestHud.astro";
import LaunchPanel from "../../components/test/LaunchPanel.astro";
import Eyebrow from "../../components/site/Eyebrow.astro";
import Card from "../../components/site/Card.astro";
import { getTest } from "../../lib/tests";
import type { PatternDef } from "../../lib/patternRunner";

const test = getTest("inversion");
if (!test) throw new Error("Missing registry entry: inversion");

const LIMITATION =
  "This is a perceptual test, not a measurement. What you see depends on your browser zoom, your operating system's display scaling and your own flicker sensitivity, and a browser cannot separate panel inversion from GPU or driver dithering — both produce shimmer on the same patterns. Treat a positive result as a reason to compare this panel against another one, not as a diagnosis on its own.";

const PATTERNS: readonly PatternDef[] = [
  {
    id: "checker-1",
    name: "1px checkerboard",
    reveals:
      "The worst case for every inversion scheme. Flicker, a crawling shimmer, or horizontal bands that sit still while your head does means residual voltage imbalance.",
  },
  {
    id: "h-lines-1",
    name: "1px horizontal lines",
    reveals:
      "Targets line-inversion panels. Look for slow brightness pulsing across the whole field, or a wide band drifting down the screen.",
  },
  {
    id: "v-lines-1",
    name: "1px vertical lines",
    reveals:
      "Targets column drive. Vertical streaks that brighten and dim, or a visible seam partway across, point at the source drivers rather than the row scheme.",
  },
  {
    id: "h-lines-2",
    name: "2px horizontal lines",
    reveals:
      "Two-line inversion panels look clean on the 1px pattern and fail here. If this one flickers and the 1px one did not, that is your scheme.",
  },
  {
    id: "grey-50",
    name: "50% grey reference",
    reveals:
      "The control. A flat mid-grey has no alternating structure to expose, so it must look perfectly still. If this flickers too, the cause is the backlight or the refresh rate, not inversion.",
  },
];
---

<TestPageLayout
  title="Pixel Inversion Test — Check for Voltage Inversion Flicker"
  description="Full-screen single-pixel checkerboards and line patterns that expose LCD voltage-inversion artefacts. Free, in-browser, no install. Explains what inversion is, how to read the result and what you can actually do about it."
  heading="Pixel inversion test"
  lede={test.description}
  category="pixels"
  slug="inversion"
  limitation={LIMITATION}
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14">
    <div class="max-w-prose">
      <LaunchPanel
        label="Launch inversion patterns"
        prerequisites={[
          "Set browser zoom to exactly 100%. At any other zoom the browser resamples a 1px line and the pattern stops being worst-case.",
          "Sit about 50cm from the screen, straight on, and keep your head still while you judge.",
          "Turn off any monitor motion-smoothing or dynamic-contrast mode first — both add their own flicker.",
        ]}
      />

      <section class="mt-12">
        <Eyebrow as="h2">The cause</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Why every LCD flips polarity
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            Liquid crystal responds to the strength of an electric field, not its
            direction. That is fortunate, because a constant DC bias across a
            cell would drive ion migration in the crystal layer and permanently
            damage it &mdash; you would burn a fixed image into the panel within
            hours. So every LCD alternates the polarity of the voltage across
            each cell, typically every frame.
          </p>
          <p>
            Manufacturers choose <em>which</em> cells flip together. Line
            inversion alternates polarity row by row, dot inversion alternates
            every cell like a chessboard, and two-line inversion works in pairs.
            Each scheme is a trade between power draw and how visible the
            residual imbalance is.
          </p>
          <p>
            The imbalance is never exactly zero. On a normal picture it is far
            below your detection threshold. Feed the panel a pattern that
            aligns perfectly with its inversion grid, though, and every cell's
            small error points the same way at the same moment &mdash; and the
            error becomes a visible flicker, shimmer, or band.
          </p>
        </div>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Reading it</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          Good, faulty, and the trap in between
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            <strong class="font-medium text-ink">Good.</strong> Each pattern
            looks like a static, evenly textured grey field. You may see it as
            slightly darker or lighter than the 50% grey reference &mdash; that
            is normal gamma behaviour, not a fault. Nothing moves.
          </p>
          <p>
            <strong class="font-medium text-ink">Faulty.</strong> The field
            visibly pulses, crawls, or carries horizontal bands that drift
            slowly down the screen, all while your head is completely still.
            Strong inversion is often easier to catch in peripheral vision:
            look slightly to one side of the screen and it jumps out.
          </p>
          <p>
            <strong class="font-medium text-ink">The trap.</strong> Shimmer that
            appears only when you move your head or shift your eyes is moir&eacute;
            &mdash; interference between the pixel grid and your own retina &mdash;
            and every display does it. That is not inversion. The signature of a
            real inversion artefact is movement on screen while you are still.
            Test the difference deliberately: hold still, then move, then hold
            still again.
          </p>
        </div>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Why it matters</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">
          The headache nobody can explain
        </h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            Inversion artefacts are one of the most common reasons a new monitor
            causes eye strain or headaches when the previous one did not. Small
            text, thin table borders, code with fine syntax highlighting and
            single-pixel UI dividers all contain near-worst-case patterns, and
            scrolling drags them across the inversion grid continuously. The
            flicker is often below the level you would consciously notice while
            still being enough to fatigue you over an eight-hour day.
          </p>
          <p>
            If that describes your experience and these patterns flicker, you
            have found a plausible cause. Check whether it changes with the
            refresh rate &mdash; on the
            <a
              href="/test/refresh-rate"
              class="text-link underline decoration-link-bg-soft underline-offset-2 hover:decoration-link"
              >refresh rate test</a
            >, confirm the panel is running at its highest supported rate, since
            some displays only exhibit strong inversion at 60&nbsp;Hz.
          </p>
        </div>
      </section>

      <section class="mt-12">
        <Eyebrow as="h2">Remedy</Eyebrow>
        <h2 class="mt-2 text-display-sm text-ink">What you can do</h2>
        <div class="mt-3 flex flex-col gap-4 text-body-md text-body">
          <p>
            Inversion behaviour is fixed in the panel's timing controller, so
            there is no setting that removes it. What you can change is how much
            of it reaches your eyes:
          </p>
          <ul class="flex flex-col gap-3">
            <li>
              <strong class="font-medium text-ink">Raise the refresh rate.</strong>
              A higher rate flips polarity more often per second, pushing the
              artefact further above your flicker fusion threshold.
            </li>
            <li>
              <strong class="font-medium text-ink"
                >Raise brightness, lower contrast in software.</strong
              > Backlight flicker from PWM dimming compounds inversion. A panel run
              at low backlight with software-boosted contrast is the worst case.
            </li>
            <li>
              <strong class="font-medium text-ink">Compare before you keep it.</strong>
              This is a design characteristic, not a manufacturing defect, so it
              is usually not covered by a dead-pixel warranty. It <em>is</em> covered
              by a return window. Run this test on day one, not month three.
            </li>
          </ul>
        </div>
      </section>
    </div>

    <aside class="lg:pt-1">
      <Card elevation="e2" padding="lg">
        <Eyebrow as="h2">Patterns</Eyebrow>
        <ol class="mt-4 flex flex-col gap-3 text-body-sm text-body">
          {
            PATTERNS.map((pattern, i) => (
              <li>
                <p class="font-medium text-ink">
                  <span class="font-mono text-caption text-mute">
                    {String(i + 1).padStart(2, "0")}
                  </span>{" "}
                  {pattern.name}
                </p>
                <p class="mt-0.5">{pattern.reveals}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-caption text-mute">
          Arrow keys or <kbd
            class="rounded-xs border border-hairline bg-canvas-soft-2 px-1 font-mono text-caption"
            >K</kbd
          > / <kbd
            class="rounded-xs border border-hairline bg-canvas-soft-2 px-1 font-mono text-caption"
            >J</kbd
          > move between patterns without leaving full screen.
        </p>
      </Card>
    </aside>
  </div>

  <!-- The pattern list crosses from frontmatter to the client here rather than
       being retyped in the module script below. Two copies of this array would
       drift the moment anyone edited one of them. -->
  <script
    slot="surface"
    is:inline
    type="application/json"
    data-pattern-config
    set:html={JSON.stringify(PATTERNS)}
  />

  <TestSurface slot="surface" id="surface">
    <!-- One layer, restyled per pattern by CSS. A single element means the
         browser never cross-fades or composites two patterns together. -->
    <div
      class="inv-layer"
      data-inv-layer
      role="img"
      aria-label="Full screen single-pixel inversion pattern"
    >
    </div>

    <TestHud slot="hud" label="Inversion pattern controls">
      <p data-hud-note class="dpt-hud-note" hidden></p>

      <div class="dpt-hud-group">
        <button
          type="button"
          data-nav-prev
          class="dpt-hud-btn dpt-hud-btn--icon"
          aria-label="Previous pattern"
        >
          <span aria-hidden="true">&#9664;</span>
        </button>
        <span class="dpt-hud-label">
          <b data-pattern-name>1px checkerboard</b>
          <span class="dpt-hud-sub" data-pattern-position>1 / 5</span>
        </span>
        <button
          type="button"
          data-nav-next
          class="dpt-hud-btn dpt-hud-btn--icon"
          aria-label="Next pattern"
        >
          <span aria-hidden="true">&#9654;</span>
        </button>
      </div>

      <div class="dpt-hud-group">
        <button type="button" data-hud-help aria-pressed="false" class="dpt-hud-btn">
          Help
          <kbd class="dpt-hud-kbd">H</kbd>
        </button>
        <button type="button" data-surface-exit class="dpt-hud-btn">
          Exit
          <kbd class="dpt-hud-kbd">Esc</kbd>
        </button>
      </div>

      <div data-help-panel hidden class="inv-help">
        <p data-pattern-reveals></p>
        <p class="dpt-hud-sub">
          Hold your head still. Shimmer only while moving is normal moir&eacute;,
          not a fault.
        </p>
      </div>

      <p data-pattern-status role="status" aria-live="polite" class="inv-sr"></p>
    </TestHud>
  </TestSurface>
</TestPageLayout>

<style>
  /* ── DEVICE PIXELS VERSUS CSS PIXELS ─────────────────────────────────────
     These patterns must be authored in CSS px, because that is the only unit
     a stylesheet has. On a HiDPI display one CSS px spans 2 or 3 device
     pixels, so a "1px" band here is physically 2 or 3 panel rows wide and the
     pattern is no longer the true worst case for the inversion grid — it is
     the worst case for a 2x-coarser grid, which some schemes survive.

     There is no CSS unit for a device pixel, and drawing to a canvas at
     devicePixelRatio would put the fill through a compositing pass, which the
     COLOUR PURITY CONTRACT in TestSurface.astro forbids. So we do the honest
     thing: author in CSS px, and tell the user on the page to hold browser
     zoom at 100% and to treat a HiDPI clean pass as inconclusive rather than
     proof. A clean result on a 1x display is meaningful; on a 3x phone panel
     it mostly is not.

     Every pattern is a gradient with hard stops — no soft stop anywhere. A
     soft stop would be interpolated across the band and the edges would blur
     into exactly the grey we are trying to avoid. */

  .inv-layer {
    position: absolute;
    inset: 0;
    background-color: #808080;
    /* Belt and braces against smoothing on the gradient tiles. */
    image-rendering: pixelated;
  }

  /* 1px checkerboard. A conic-gradient in four quadrants tiled at 2px x 2px
     gives a true alternating single-pixel grid; repeating-linear-gradient
     cannot express a checker in one declaration. */
  :global(.dpt-surface[data-pattern="checker-1"]) .inv-layer {
    background-image: conic-gradient(
      #ffffff 0deg 90deg,
      #000000 90deg 180deg,
      #ffffff 180deg 270deg,
      #000000 270deg 360deg
    );
    background-size: 2px 2px;
    background-repeat: repeat;
  }

  :global(.dpt-surface[data-pattern="h-lines-1"]) .inv-layer {
    background-image: repeating-linear-gradient(
      to bottom,
      #ffffff 0px 1px,
      #000000 1px 2px
    );
  }

  :global(.dpt-surface[data-pattern="v-lines-1"]) .inv-layer {
    background-image: repeating-linear-gradient(
      to right,
      #ffffff 0px 1px,
      #000000 1px 2px
    );
  }

  :global(.dpt-surface[data-pattern="h-lines-2"]) .inv-layer {
    background-image: repeating-linear-gradient(
      to bottom,
      #ffffff 0px 2px,
      #000000 2px 4px
    );
  }

  /* The reference. No image at all — the flat background-color shows through,
     so there is nothing here that could be resampled. */
  :global(.dpt-surface[data-pattern="grey-50"]) .inv-layer {
    background-image: none;
  }

  .inv-help {
    width: 100%;
    max-width: 34rem;
    padding-top: 0.375rem;
    border-top: 1px solid #262626;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }

  .inv-help[hidden] {
    display: none;
  }

  .inv-help p + p {
    margin-top: 0.375rem;
  }

  .inv-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { mountPatternRunner, type PatternDef } from "../../lib/patternRunner";

  const configEl = document.querySelector<HTMLScriptElement>(
    "[data-pattern-config]",
  );
  if (configEl?.textContent) {
    mountPatternRunner({
      patterns: JSON.parse(configEl.textContent) as PatternDef[],
    });
  }
</script>
