---
/**
 * Homepage.
 *
 * One job above the fold: get someone who just unboxed a monitor into a
 * full-screen white field in a single click. Everything explanatory sits below
 * that, because a visitor with a suspected defect has not come here to read.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import MeshGradient from "../components/site/MeshGradient.astro";
import Button from "../components/site/Button.astro";
import Card from "../components/site/Card.astro";
import Eyebrow from "../components/site/Eyebrow.astro";
import Badge from "../components/site/Badge.astro";
import AdSlot from "../components/site/AdSlot.astro";
import { FILLS } from "../lib/palette";
import { groupedTests, TESTS } from "../lib/tests";

const groups = groupedTests();

const differentiators = [
  {
    title: "Real fills on mobile, not video",
    body: "Some tools serve a compressed video on phones, claiming browsers cannot render full-screen colour. They can. Compression both hides real defects and invents ones that are not there, so every fill here is painted by the browser at exact sRGB values.",
  },
  {
    title: "Every test in one place",
    body: "Refresh rate, backlight bleed, pixel inversion, response time and panel uniformity all live here. No hand-offs to a second site halfway through checking a new display.",
  },
  {
    title: "You get a report, not a shrug",
    body: "Tap each fault as you find it. The result is a map of your panel plus an ISO 9241-307 fault class you can quote when you open a warranty claim.",
  },
  {
    title: "Works with the Wi-Fi off",
    body: "The whole suite is cached on first visit. Useful in a shop, a warehouse, or anywhere you are testing hardware before it is connected to anything.",
  },
];

const steps = [
  {
    n: "01",
    title: "Clean the screen first",
    body: "A speck of dust is the most common false positive there is. Wipe the panel with a dry microfibre cloth before you start, or you will spend ten minutes hunting a crumb.",
  },
  {
    n: "02",
    title: "Dim the room",
    body: "Backlight bleed, clouding and faint stuck sub-pixels are invisible in daylight. Turn the lights down and let your eyes adjust for a minute.",
  },
  {
    n: "03",
    title: "Run the guided sequence",
    body: "Twelve fills in the order that makes faults easiest to see — light to dark, then the primaries and secondaries that isolate individual sub-pixels.",
  },
  {
    n: "04",
    title: "Mark what you find",
    body: "Tap each defect. Nothing is uploaded — the log lives in your browser and goes away when you clear it.",
  },
];
---

<SiteLayout
  title="Dead Pixel Test — Free Full-Screen Screen & Monitor Test"
  description="Test any screen for dead pixels, stuck pixels, backlight bleed and banding. Exact sRGB full-screen fills, no video compression, works offline, and gives you an ISO 9241-307 fault class for warranty claims."
  bleed
>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="relative isolate overflow-hidden border-b border-hairline">
    <MeshGradient />

    <div
      class="relative mx-auto max-w-page px-4 pt-16 pb-20 md:px-6 md:pt-24 md:pb-28"
    >
      <div class="max-w-3xl">
        <Badge tone="info">No ads &middot; No tracking &middot; No account</Badge>

        <h1 class="mt-5 text-display-lg text-ink md:text-display-xl">
          Find every dead pixel on your screen in about two minutes.
        </h1>

        <p class="mt-5 max-w-2xl text-body-lg text-body">
          Twelve exact full-screen colour fills, rendered by your browser at true
          sRGB values &mdash; no video, no compression, nothing that could hide a
          fault or fake one. Works on phones, tablets, laptops and TVs.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href="/test/sequence" size="lg" shape="pill">
            Start the guided test
          </Button>
          <Button href="/test/white" size="lg" shape="pill" variant="secondary">
            Jump to a white screen
          </Button>
        </div>

        <p class="mt-4 text-body-sm text-mute">
          Free, and it stays free. Nothing you find leaves your device.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Fast lane: the twelve fills ───────────────────────────────────── -->
  <section class="mx-auto max-w-page px-4 py-16 md:px-6 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <Eyebrow>Single fills</Eyebrow>
        <h2 class="mt-2 text-display-md text-ink">
          Straight to one colour
        </h2>
        <p class="mt-2 max-w-prose text-body-md text-body">
          Already know what you are looking for? Open the fill you need. Arrow
          keys move between them without leaving full screen.
        </p>
      </div>
    </div>

    <ul
      class="mt-8 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-12"
    >
      {
        FILLS.map((fill) => (
          <li>
            <a
              href={`/test/${fill.slug}`}
              class="group block rounded-md p-1 transition-colors duration-150 ease-out hover:bg-canvas-soft-2"
            >
              <span
                class="block aspect-square w-full rounded-sm shadow-e1"
                style={`background-color:${fill.hex}`}
                aria-hidden="true"
              />
              <span class="mt-2 block text-caption text-body group-hover:text-ink">
                {fill.name}
              </span>
              <span class="block font-mono text-caption text-mute uppercase">
                {fill.hex}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <AdSlot id="home-mid" />

  <!-- ── Why this one ──────────────────────────────────────────────────── -->
  <section class="border-y border-hairline bg-canvas">
    <div class="mx-auto max-w-page px-4 py-16 md:px-6 md:py-20">
      <Eyebrow>Why this one</Eyebrow>
      <h2 class="mt-2 max-w-2xl text-display-md text-ink">
        Most screen tests stop at a coloured rectangle.
      </h2>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {
          differentiators.map((item) => (
            <Card elevation="e2" padding="lg">
              <h3 class="text-display-sm text-ink">{item.title}</h3>
              <p class="mt-2 text-body-md text-body">{item.body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── The full suite ────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-page px-4 py-16 md:px-6 md:py-20">
    <Eyebrow>The suite</Eyebrow>
    <h2 class="mt-2 text-display-md text-ink">
      {TESTS.length} tests, one site
    </h2>
    <p class="mt-2 max-w-prose text-body-md text-body">
      Everything you need to accept or reject a new display, grouped by what it
      actually tells you.
    </p>

    <div class="mt-10 flex flex-col gap-12">
      {
        groups.map((group) => (
          <div>
            <h3 class="text-display-sm text-ink">{group.label}</h3>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.tests.map((test) => (
                <li>
                  <Card href={test.href} elevation="e2" padding="lg" class="h-full">
                    <div class="flex items-start justify-between gap-3">
                      <h4 class="text-body-lg font-medium text-ink">
                        {test.name}
                      </h4>
                      {test.needsDarkRoom && (
                        <Badge tone="neutral">Dark room</Badge>
                      )}
                    </div>
                    <p class="mt-2 text-body-sm text-body">{test.blurb}</p>
                    {test.limitation && (
                      <p class="mt-3 text-caption text-warning-deep">
                        Perceptual test &mdash; read the limits on the page.
                      </p>
                    )}
                  </Card>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── How to get a result you can trust ─────────────────────────────── -->
  <section class="border-t border-hairline bg-canvas">
    <div class="mx-auto max-w-page px-4 py-16 md:px-6 md:py-20">
      <Eyebrow>Before you start</Eyebrow>
      <h2 class="mt-2 max-w-2xl text-display-md text-ink">
        Four things that decide whether your result means anything
      </h2>

      <ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step) => (
            <li>
              <p class="font-mono text-caption text-mute">{step.n}</p>
              <h3 class="mt-2 text-body-lg font-medium text-ink">
                {step.title}
              </h3>
              <p class="mt-2 text-body-sm text-body">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12">
        <Button href="/test/sequence" size="lg" shape="pill">
          Start the guided test
        </Button>
      </div>
    </div>
  </section>
</SiteLayout>
